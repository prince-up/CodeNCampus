{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "production-codencampus": {
      "env": {
        "APP_TENANT": "default"
      }
    },
    "production-dpsrkp": {
      "env": {
        "APP_TENANT": "dpsrkp"
      }
    }
  }
}
