{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview-dpsrkp": {
      "distribution": "internal",
      "env": {
        "APP_TENANT": "dpsrkp"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-modern": {
      "distribution": "internal",
      "env": {
        "APP_TENANT": "modern"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "production-codencampus": {
      "env": {
        "APP_TENANT": "default"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    },
    "production-dpsrkp": {
      "env": {
        "APP_TENANT": "dpsrkp"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    },
    "production-modern": {
      "env": {
        "APP_TENANT": "modern"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    }
  }
}
