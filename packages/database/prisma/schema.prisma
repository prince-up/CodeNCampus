generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  schools School[]

  @@map("organizations")
}

model School {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String?  @map("organization_id") @db.Uuid
  name               String   @db.VarChar(255)
  code               String   @unique @db.VarChar(50)
  affiliationNumber  String?  @map("affiliation_number") @db.VarChar(100)
  boardType          String   @map("board_type") @db.VarChar(50)
  subdomain          String   @unique @db.VarChar(100)
  customDomain       String?  @unique @map("custom_domain") @db.VarChar(255)
  logoUrl            String?  @map("logo_url")
  primaryColor       String   @default("#1E40AF") @map("primary_color") @db.VarChar(10)
  secondaryColor     String   @default("#3B82F6") @map("secondary_color") @db.VarChar(10)
  accentColor        String?  @default("#DBEAFE") @map("accent_color") @db.VarChar(10)
  appName            String?  @map("app_name") @db.VarChar(100)
  contactEmail       String   @map("contact_email") @db.VarChar(255)
  contactPhone       String   @map("contact_phone") @db.VarChar(50)
  status             String   @default("ACTIVE") @db.VarChar(50) // 'ACTIVE', 'SUSPENDED'
  subscriptionPlan   String   @default("STANDARD") @map("subscription_plan") @db.VarChar(50)
  subscriptionStatus String   @default("ACTIVE") @map("subscription_status") @db.VarChar(50)
  subscriptionExpiresAt DateTime? @map("subscription_expires_at") @db.Timestamptz
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization          Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  academicYears         AcademicYear[]
  memberships           SchoolMembership[]
  classes               Class[]
  attendanceRecords     AttendanceRecord[]
  studentProfiles       StudentProfile[]
  parentProfiles        ParentProfile[]
  staffProfiles         StaffProfile[]
  studentParentMappings StudentParentMapping[]

  @@map("schools")
}

model TenantSequence {
  schoolId     String @map("school_id") @db.Uuid
  entityType   String @map("entity_type") @db.VarChar(50) // 'STUDENT', 'STAFF', 'PARENT', 'INVOICE'
  currentValue BigInt @default(0) @map("current_value")

  @@id([schoolId, entityType])
  @@map("tenant_sequences")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String?  @unique @db.VarChar(255)
  phone        String?  @unique @db.VarChar(50)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(255)
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  memberships         SchoolMembership[]
  userRoles           UserRole[]
  recordedAttendance  AttendanceRecord[]   @relation("RecordedBy")
  studentProfile      StudentProfile?
  parentProfile       ParentProfile?
  staffProfile        StaffProfile?
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model SchoolMembership {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  readableId String   @map("readable_id") @db.VarChar(100) // e.g. 'DPS-STU-00001'
  status     String   @default("ACTIVE") @db.VarChar(50) // 'ACTIVE', 'SUSPENDED'
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@unique([schoolId, readableId])
  @@index([schoolId, status])
  @@map("school_memberships")
}

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String?  @map("school_id") @db.Uuid
  name         String   @db.VarChar(100) // 'SUPER_ADMIN', 'SCHOOL_ADMIN', 'PRINCIPAL', 'TEACHER', 'PARENT', 'STUDENT'
  isSystemRole Boolean  @default(false) @map("is_system_role")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100) // 'attendance.mark', 'marks.publish', 'users.manage', etc.
  module      String  @db.VarChar(100)
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId   String @map("user_id") @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, schoolId, roleId])
  @@map("user_roles")
}

model StudentProfile {
  id                    String    @id @default(uuid()) @db.Uuid
  schoolId              String    @map("school_id") @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  sectionId             String?   @map("section_id") @db.Uuid
  admissionNumber       String    @map("admission_number") @db.VarChar(100)
  rollNumber            Int?      @map("roll_number")
  dateOfBirth           DateTime  @map("date_of_birth") @db.Date
  gender                String    @db.VarChar(20)
  bloodGroup            String?   @map("blood_group") @db.VarChar(10)
  emergencyContactPhone String    @map("emergency_contact_phone") @db.VarChar(50)
  address               Json?     @db.JsonB
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  school         School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  section        Section?               @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parentMappings StudentParentMapping[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, sectionId])
  @@index([schoolId, deletedAt])
  @@map("student_profiles")
}

model ParentProfile {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  occupation   String?  @db.VarChar(100)
  annualIncome Decimal? @map("annual_income") @db.Decimal(15, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school          School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentMappings StudentParentMapping[]

  @@map("parent_profiles")
}

model StudentParentMapping {
  id               String   @id @default(uuid()) @db.Uuid
  schoolId         String   @map("school_id") @db.Uuid
  studentId        String   @map("student_id") @db.Uuid
  parentId         String   @map("parent_id") @db.Uuid
  relationType     String   @map("relation_type") @db.VarChar(50) // 'FATHER', 'MOTHER', 'LEGAL_GUARDIAN'
  isPrimaryContact Boolean  @default(false) @map("is_primary_contact")
  canPickup        Boolean  @default(true) @map("can_pickup")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([schoolId, parentId])
  @@map("student_parent_mappings")
}

model StaffProfile {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  employeeCode  String   @map("employee_code") @db.VarChar(100)
  department    String   @db.VarChar(100)
  designation   String   @db.VarChar(100)
  dateOfJoining DateTime @map("date_of_joining") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, employeeCode])
  @@map("staff_profiles")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash, expiresAt])
  @@map("password_reset_tokens")
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String   @db.VarChar(50)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@map("academic_years")
}

model Class {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  name         String   @db.VarChar(50)
  numericOrder Int      @map("numeric_order")
  stage        String   @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections Section[]

  @@unique([schoolId, name])
  @@map("classes")
}

model Section {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  name           String   @db.VarChar(10)
  roomNumber     String?  @map("room_number") @db.VarChar(50)
  capacity       Int?     @default(45)
  classTeacherId String?  @map("class_teacher_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  class             Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]
  students          StudentProfile[]

  @@unique([classId, name])
  @@map("sections")
}

model AttendanceRecord {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  sectionId      String   @map("section_id") @db.Uuid
  attendanceDate DateTime @map("attendance_date") @db.Date
  status         String   @db.VarChar(20)
  remarks        String?
  recordedBy     String   @map("recorded_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section  Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  recorder User    @relation("RecordedBy", fields: [recordedBy], references: [id])

  @@unique([studentId, attendanceDate])
  @@index([schoolId, attendanceDate, sectionId])
  @@map("attendance_records")
}
