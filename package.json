{
  "name": "codencampus",
  "version": "1.0.0",
  "private": true,
  "description": "Commercial Multi-Tenant School Management SaaS Platform",
  "author": "Codazk Technologies Private Limited",
  "license": "UNLICENSED",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "mobile": "pnpm --filter @codencampus/mobile start",
    "mobile:tunnel": "pnpm --filter @codencampus/mobile start:tunnel",
    "mobile:clear": "pnpm --filter @codencampus/mobile start:clear",
    "api": "pnpm --filter @codencampus/api dev",
    "web": "pnpm --filter @codencampus/web dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
